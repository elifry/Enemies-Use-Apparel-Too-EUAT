<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <AbilityDef>
    <defName>EUAT_DeployTurret</defName>
    <label>deploy turret</label>
    <description>Deploy a turret at the target location. Consumed on use.</description>
    <iconPath>Things/Pawn/Humanlike/Apparel/TurretPack/TurretPack</iconPath>
    <aiCanUse>true</aiCanUse>
    <displayOrder>300</displayOrder>
    <showWhenDrafted>false</showWhenDrafted>
    <!--<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>-->
    <hotKey>Misc4</hotKey>
    <verbProperties>
        <verbClass>Verb_CastAbility</verbClass>
        <range>22.9</range>
        <warmupTime>1.0</warmupTime>
        <soundCast>ThrowGrenade</soundCast>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <targetParams>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>  
    </verbProperties>
    <comps>
      <li Class="EnemiesUseApparelToo.CompProperties_AbilityChargesApparel">
        </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Grenade_TurretPack</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>EUAT_ShardShockLance</defName>
    <label>psychic shock lance</label>
    <description>A limited-use psychic effector. It shocks the target's mind with chaotic images, blocking coherent perception and dropping them into a state of psychic shock. There is a risk of brain damage.\n\nThis shock lance was crafted from a broken shard of dark archotechnology. It has a shorter range than its non-shard based counterpart and it requires line of sight.</description>
    <!--Placeholder Icon since the plan is just to display the verb-->
    <iconPath>UI/Abilities/Stun</iconPath>
    <showWhenDrafted>false</showWhenDrafted>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <aiCanUse>true</aiCanUse>
    <statBases>
      <Ability_Duration>125</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>False</drawAimPie>
      <range>16.9</range>
      <warmupTime>2.4</warmupTime>
      <targetParams>
        <canTargetBuildings>false</canTargetBuildings>
        <neverTargetIncapacitated>true</neverTargetIncapacitated>
      </targetParams>
      <soundCast>PsychicShockLanceCast</soundCast>
      <soundAiming>PsychicArtifactWarmupSustained</soundAiming>
    </verbProperties>
    <comps>
      <li Class="EnemiesUseApparelToo.CompProperties_AbilityChargesApparel">
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>PsychicShock</hediffDef>
        <psychic>True</psychic>
        <onlyBrain>True</onlyBrain>
        <goodwillImpact>-200</goodwillImpact>
      </li>
      <li Class="CompProperties_AbilityBrainDamageChance">
        <brainDamageChance>0.3</brainDamageChance>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_AbilityConnectingFleckLine">
        <fleckDef>PsycastPsychicLine</fleckDef>
      </li>
    </comps>
  </AbilityDef>

   <AbilityDef>
    <defName>EUAT_ShardInsanityLance</defName>
    <label>psychic insanity lance</label>
    <description>A limited-use psychic effector. It shocks the target's mind with chaotic images, blocking coherent perception and dropping them into a state of psychic shock. There is a risk of brain damage.\n\nThis shock lance was crafted from a broken shard of dark archotechnology. It has a shorter range than its non-shard based counterpart and it requires line of sight.</description>
    <!--Placeholder Icon since the plan is just to display the verb-->
    <iconPath>UI/Abilities/Stun</iconPath>
    <showWhenDrafted>false</showWhenDrafted>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <aiCanUse>true</aiCanUse>
    <statBases>
      <Ability_Duration>666</Ability_Duration>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>False</drawAimPie>
      <range>16.9</range>
      <warmupTime>2.4</warmupTime>
      <targetParams>
        <canTargetBuildings>false</canTargetBuildings>
        <neverTargetIncapacitated>true</neverTargetIncapacitated>
      </targetParams>
      <soundCast>PsychicInsanityLanceCast</soundCast>
      <soundAiming>PsychicArtifactWarmupSustained</soundAiming>
