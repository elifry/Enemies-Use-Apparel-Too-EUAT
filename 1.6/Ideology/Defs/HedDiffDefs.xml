      <li>EUAT_ImplantIdeologyAbility</li>
    </techHediffsTags>
  </ThingDef>
  
  <HediffDef ParentName="ImplantHediffBase">
    <defName>EUAT_BerserkTrance</defName>
    <label>berserk trance</label>
    <labelNoun>a berserk trance</labelNoun>
    <description>This Pawn can fill themselves with anger over ideological grievances. This strengthens the body past normal limits, but also means losing control and attacking every enemy nearby in an unstoppable rage. The berserk state will last for 3 hours.</description>
    <descriptionHyperlinks><ThingDef>EUAT_BerserkTrance</ThingDef></descriptionHyperlinks>
    <abilities>
      <li>EUAT_BerserkTrance</li>
    </abilities>
    <comps>
      <li Class="EnemiesUseApparelToo.HediffCompProperties_RemovedOnDowned"/>
    </comps>
  </HediffDef>

