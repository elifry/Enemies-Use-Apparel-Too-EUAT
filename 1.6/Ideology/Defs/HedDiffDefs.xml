  <RecipeDef ParentName="SurgeryInstallImplantBase">
    <defName>EUAT_InstallBerserkTrance</defName>
    <label>install EUAT_BerserkTrance</label>
    <description>Install a EUAT_BerserkTrance.</description>
    <descriptionHyperlinks>
      <ThingDef>EUAT_BerserkTrance</ThingDef>
      <HediffDef>EUAT_BerserkTrance</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing EUAT_BerserkTrance.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EUAT_BerserkTrance</li>
          </thingDefs>
        </filter>
        <count>1</count>
